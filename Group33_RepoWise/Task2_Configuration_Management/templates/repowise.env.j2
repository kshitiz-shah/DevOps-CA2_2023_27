NODE_ENV=production
PORT={{ app_port }}

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://repowise:repowise_production_secure_pass@127.0.0.1:{{ database_port }}/repowise?schema=public"

# Qdrant Vector Database Endpoint
QDRANT_URL="http://127.0.0.1:{{ qdrant_port }}"

# JWT Authentication Secret
JWT_SECRET="{{ jwt_secret | default('repowise_jwt_super_secret_production_key_2026') }}"

# Logging
LOG_LEVEL=info
